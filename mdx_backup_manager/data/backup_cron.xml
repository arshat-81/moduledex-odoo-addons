<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="cron_backup_run_due" model="ir.cron">
        <field name="name">Verified Backup: run due destinations</field>
        <field name="model_id" ref="model_mdx_backup_destination"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_due()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="user_id" ref="base.user_root"/>
        <!-- Hourly, because each destination decides for itself whether it is
             due. A daily cron would make an "every 6 hours" destination a lie. -->
    </record>
</odoo>
