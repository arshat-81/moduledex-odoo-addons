<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_data_insight" model="ir.module.category">
        <field name="name">Data Insight</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_data_insight_reader" model="res.groups">
        <field name="name">Reader</field>
        <field name="category_id" ref="data_insight_workbench.module_category_data_insight"/>
    </record>

    <record id="group_data_insight_designer" model="res.groups">
        <field name="name">Designer</field>
        <field name="category_id" ref="data_insight_workbench.module_category_data_insight"/>
        <field name="implied_ids" eval="[(4, ref('data_insight_workbench.group_data_insight_reader'))]"/>
    </record>

    <record id="group_data_insight_executor" model="res.groups">
        <field name="name">Executor</field>
        <field name="category_id" ref="data_insight_workbench.module_category_data_insight"/>
        <field name="implied_ids" eval="[(4, ref('data_insight_workbench.group_data_insight_reader'))]"/>
    </record>

    <record id="group_data_insight_admin" model="res.groups">
        <field name="name">Administrator</field>
        <field name="category_id" ref="data_insight_workbench.module_category_data_insight"/>
        <field name="implied_ids" eval="[
            (4, ref('data_insight_workbench.group_data_insight_designer')),
            (4, ref('data_insight_workbench.group_data_insight_executor'))
        ]"/>
    </record>

    <record id="group_data_insight_full_access" model="res.groups">
        <field name="name">Full SQL Access</field>
        <field name="category_id" ref="data_insight_workbench.module_category_data_insight"/>
        <field name="implied_ids" eval="[(4, ref('data_insight_workbench.group_data_insight_admin'))]"/>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('data_insight_workbench.group_data_insight_full_access'))]"/>
    </record>
</odoo>
