<odoo>
    <record id="view_bigcommerce_publish_wizard_form" model="ir.ui.view">
        <field name="name">bigcommerce.publish.wizard.form</field>
        <field name="model">bigcommerce.publish.wizard</field>
        <field name="arch" type="xml">
            <form string="Publish to BigCommerce">
                <div class="alert alert-info" role="alert">
                    This creates the selected products on BigCommerce as new catalog
                    products. Products already linked to BigCommerce are skipped.
                </div>
                <group>
                    <field name="config_id"/>
                    <field name="category_id"/>
                    <field name="is_visible"/>
                    <field name="push_inventory"/>
                </group>
                <field name="product_tmpl_ids">
                    <list create="0">
                        <field name="name"/>
                        <field name="default_code"/>
                        <field name="list_price"/>
                    </list>
                </field>
                <footer>
                    <button name="action_publish" type="object" string="Publish" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_bigcommerce_publish_wizard" model="ir.actions.act_window">
        <field name="name">Publish to BigCommerce</field>
        <field name="res_model">bigcommerce.publish.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
