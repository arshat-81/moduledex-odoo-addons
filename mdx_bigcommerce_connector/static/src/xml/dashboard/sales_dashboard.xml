<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="mdx_bigcommerce_connector.SalesDashboard">
        <Layout display="this.display">
            <div class="bc_dashboard">
                <div class="bc_dashboard_toolbar">
                    <h2 class="bc_dashboard_title">
                        <i class="oi" data-icon="shopping_cart" role="img" aria-hidden="true"/> Sales Dashboard
                    </h2>
                    <select class="bc_store_select" t-on-change="this.onConfigChange">
                        <option value="">All Stores</option>
                        <t t-foreach="this.state.configs" t-as="config" t-key="config.id">
                            <option t-att-value="config.id" t-att-selected="config.id === this.state.configId">
                                <t t-out="config.name"/>
                            </option>
                        </t>
                    </select>
                </div>

                <t t-if="this.state.data">
                    <div class="bc_kpi_row">
                        <BigcommerceKpiCard
                            label="'Today'"
                            value="this.formatMoney(this.state.data.today.revenue)"
                            sublabel="`${this.state.data.today.orders} orders`"
                            icon="'calendar_today'" accent="'primary'"/>
                        <BigcommerceKpiCard
                            label="'Last 7 Days'"
                            value="this.formatMoney(this.state.data.last_7_days.revenue)"
                            sublabel="`${this.state.data.last_7_days.orders} orders`"
                            icon="'show_chart'" accent="'primary'"/>
                        <BigcommerceKpiCard
                            label="'Last 30 Days'"
                            value="this.formatMoney(this.state.data.last_30_days.revenue)"
                            sublabel="`${this.state.data.last_30_days.orders} orders`"
                            icon="'bar_chart'" accent="'primary'"/>
                        <BigcommerceKpiCard
                            label="'All Time'"
                            value="this.formatMoney(this.state.data.all_time.revenue)"
                            sublabel="`${this.state.data.all_time.orders} orders`"
                            icon="'public'" accent="'primary'"/>
                        <BigcommerceKpiCard
                            label="'Cart Recovery'"
                            value="`${this.state.data.carts_recovery_rate}%`"
                            sublabel="`${this.state.data.carts_converted} of ${this.state.data.carts_abandoned + this.state.data.carts_converted} recovered`"
                            icon="'shopping_basket'" accent="'success'"/>
                        <BigcommerceKpiCard
                            label="'Products Synced'"
                            value="`${this.state.data.product_count}`"
                            icon="'inventory_2'" accent="'warning'"/>
                    </div>

                    <div class="bc_chart_row">
                        <div class="bc_chart_card bc_chart_card--wide">
                            <div class="bc_chart_card_title">Revenue by Storefront</div>
                            <div class="bc_chart_card_canvas">
                                <canvas t-ref="this.channelChart.ref"/>
                            </div>
                        </div>
                        <div class="bc_chart_card">
                            <div class="bc_chart_card_title">Cart Funnel</div>
                            <div class="bc_chart_card_canvas">
                                <canvas t-ref="this.cartChart.ref"/>
                            </div>
                        </div>
                    </div>
                </t>
            </div>
        </Layout>
    </t>

</templates>
