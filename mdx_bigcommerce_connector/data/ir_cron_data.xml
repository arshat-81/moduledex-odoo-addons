<odoo noupdate="1">
    <record id="ir_cron_bigcommerce_sync_orders" model="ir.cron">
        <field name="name">BigCommerce: Sync Orders (fallback for missed webhooks)</field>
        <field name="model_id" ref="model_bigcommerce_config"/>
        <field name="state">code</field>
        <field name="code">
for config in env['bigcommerce.config'].search([('active', '=', True), ('state', '=', 'connected')]):
    config.action_sync_orders()
        </field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_bigcommerce_sync_inventory" model="ir.cron">
        <field name="name">BigCommerce: Sync Products &amp; Inventory</field>
        <field name="model_id" ref="model_bigcommerce_config"/>
        <field name="state">code</field>
        <field name="code">
for config in env['bigcommerce.config'].search([('active', '=', True), ('state', '=', 'connected')]):
    config.action_sync_products()
        </field>
        <field name="interval_number">30</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <!-- No cron for carts: BigCommerce has no bulk cart-listing endpoint,
         confirmed against the live API. Cart capture is webhook-only —
         see controllers/webhook.py. -->

    <record id="ir_cron_bigcommerce_run_jobs" model="ir.cron">
        <field name="name">BigCommerce: Run queued jobs</field>
        <field name="model_id" ref="model_bigcommerce_job"/>
        <field name="state">code</field>
        <field name="code">
size = max(env['bigcommerce.config'].search([('use_job_queue','=',True)]).mapped('job_batch_size') or [50])
model.cron_run_jobs(limit=size)
        </field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>

    <record id="ir_cron_bigcommerce_vacuum_jobs" model="ir.cron">
        <field name="name">BigCommerce: Clean up finished jobs</field>
        <field name="model_id" ref="model_bigcommerce_job"/>
        <field name="state">code</field>
        <field name="code">model.cron_vacuum(days=7)</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
