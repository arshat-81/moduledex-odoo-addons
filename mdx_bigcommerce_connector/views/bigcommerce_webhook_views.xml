<odoo>
    <record id="view_bigcommerce_webhook_list" model="ir.ui.view">
        <field name="name">bigcommerce.webhook.list</field>
        <field name="model">bigcommerce.webhook</field>
        <field name="arch" type="xml">
            <list string="Webhooks" decoration-danger="is_disabled_by_bc">
                <field name="config_id"/>
                <field name="scope"/>
                <field name="bc_webhook_id"/>
                <field name="active"/>
                <field name="is_disabled_by_bc"/>
                <field name="last_delivery_exception"/>
            </list>
        </field>
    </record>

    <record id="action_bigcommerce_webhook" model="ir.actions.act_window">
        <field name="name">Webhooks</field>
        <field name="res_model">bigcommerce.webhook</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
