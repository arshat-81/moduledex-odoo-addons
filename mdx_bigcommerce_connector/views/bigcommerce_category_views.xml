<odoo>
    <record id="view_bigcommerce_category_list" model="ir.ui.view">
        <field name="name">bigcommerce.category.list</field>
        <field name="model">bigcommerce.category</field>
        <field name="arch" type="xml">
            <list string="Categories">
                <field name="config_id"/>
                <field name="name"/>
                <field name="parent_id"/>
                <field name="category_id"/>
            </list>
        </field>
    </record>

    <record id="action_bigcommerce_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">bigcommerce.category</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
