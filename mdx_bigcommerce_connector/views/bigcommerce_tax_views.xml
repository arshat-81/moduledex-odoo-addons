<odoo>
    <record id="view_bigcommerce_tax_mapping_list" model="ir.ui.view">
        <field name="name">bigcommerce.tax.mapping.list</field>
        <field name="model">bigcommerce.tax.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="config_id"/>
                <field name="rate" string="BigCommerce Rate (%)"/>
                <field name="bc_tax_class_id" optional="show"/>
                <field name="company_id" column_invisible="True"/>
                <field name="account_tax_id"/>
                <field name="auto_created" string="Auto" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_bigcommerce_tax_mapping_form" model="ir.ui.view">
        <field name="name">bigcommerce.tax.mapping.form</field>
        <field name="model">bigcommerce.tax.mapping</field>
        <field name="arch" type="xml">
            <form string="Tax Mapping">
                <sheet>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="rate"/>
                            <field name="bc_tax_class_id"/>
                        </group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="account_tax_id"/>
                            <field name="auto_created" readonly="1"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        BigCommerce reports tax as <strong>amounts</strong>, not as a tax record,
                        so the connector derives the effective rate from each order line
                        (<code>total_tax / total_ex_tax</code>) and uses this table to decide
                        which Odoo tax to apply. Change the Odoo tax here to correct it -
                        existing orders are not re-taxed, only new imports.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_bigcommerce_tax_mapping" model="ir.actions.act_window">
        <field name="name">Tax Mappings</field>
        <field name="res_model">bigcommerce.tax.mapping</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No tax mappings yet</p>
            <p>
                These are created automatically the first time an order arrives carrying tax.
                Add one by hand to pin a BigCommerce rate to a specific Odoo tax.
            </p>
        </field>
    </record>
</odoo>
