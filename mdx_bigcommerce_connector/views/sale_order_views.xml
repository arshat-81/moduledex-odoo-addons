<odoo>
    <record id="view_order_form_bigcommerce" model="ir.ui.view">
        <field name="name">sale.order.form.bigcommerce</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="BigCommerce" invisible="not bigcommerce_order_id">
                    <button name="action_bigcommerce_resync" type="object"
                            string="Sync Now from BigCommerce" class="btn-secondary mb-3"
                            icon="fa-refresh"/>
                    <group>
                        <group>
                            <field name="bigcommerce_config_id" readonly="1"/>
                            <field name="bigcommerce_channel_id" readonly="1"/>
                            <field name="bigcommerce_order_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="bigcommerce_status" readonly="1"/>
                            <field name="bigcommerce_created_at" readonly="1"/>
                        </group>
                    </group>
                    <field name="refund_ids">
                        <list>
                            <field name="bc_refund_id"/>
                            <field name="amount"/>
                            <field name="reason"/>
                            <field name="state"/>
                            <field name="credit_note_id"/>
                        </list>
                    </field>
                    <group string="Status History">
                        <field name="bigcommerce_status_history_ids" nolabel="1">
                            <list create="0" delete="0">
                                <field name="changed_at"/>
                                <field name="previous_status"/>
                                <field name="status"/>
                                <field name="source"/>
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
