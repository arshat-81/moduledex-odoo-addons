<odoo>
    <record id="view_bigcommerce_job_list" model="ir.ui.view">
        <field name="name">bigcommerce.job.list</field>
        <field name="model">bigcommerce.job</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'failed'"
                  decoration-muted="state in ('done','cancelled')"
                  decoration-info="state == 'running'"
                  create="false">
                <field name="create_date" string="Queued"/>
                <field name="name"/>
                <field name="config_id"/>
                <field name="run_id" optional="show"/>
                <field name="method" optional="hide"/>
                <field name="attempts" string="Try"/>
                <field name="max_attempts" string="Max" optional="hide"/>
                <field name="run_after" optional="hide"/>
                <field name="finished_at" optional="hide"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-danger="state == 'failed'"
                       decoration-warning="state == 'running'"/>
                <button name="action_run_now" type="object" string="Run now"
                        icon="fa-play" invisible="state not in ('pending','failed')"/>
                <button name="action_requeue" type="object" string="Retry"
                        icon="fa-refresh" invisible="state not in ('failed','cancelled')"/>
                <button name="action_cancel" type="object" string="Cancel"
                        icon="fa-times" invisible="state not in ('pending','failed')"/>
            </list>
        </field>
    </record>

    <record id="view_bigcommerce_job_form" model="ir.ui.view">
        <field name="name">bigcommerce.job.form</field>
        <field name="model">bigcommerce.job</field>
        <field name="arch" type="xml">
            <form string="Queued Job" create="false">
                <header>
                    <button name="action_run_now" type="object" string="Run now"
                            class="btn-primary" invisible="state not in ('pending','failed')"/>
                    <button name="action_requeue" type="object" string="Retry"
                            invisible="state not in ('failed','cancelled')"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="state not in ('pending','failed')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,running,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="config_id"/>
                            <field name="model_name"/>
                            <field name="res_id"/>
                            <field name="method"/>
                        </group>
                        <group>
                            <field name="run_id"/>
                            <field name="priority"/>
                            <field name="attempts"/>
                            <field name="max_attempts"/>
                            <field name="run_after"/>
                            <field name="started_at"/>
                            <field name="finished_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                            <field name="payload" widget="text" readonly="1"/>
                        </page>
                        <page string="Error" invisible="not error">
                            <field name="error" widget="text" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_bigcommerce_job_search" model="ir.ui.view">
        <field name="name">bigcommerce.job.search</field>
        <field name="model">bigcommerce.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="run_id"/>
                <field name="config_id"/>
                <filter name="f_pending" string="Pending" domain="[('state','=','pending')]"/>
                <filter name="f_running" string="Running" domain="[('state','=','running')]"/>
                <filter name="f_failed" string="Failed" domain="[('state','=','failed')]"/>
                <filter name="f_done" string="Done" domain="[('state','=','done')]"/>
                <separator/>
                <filter name="f_today" string="Today"
                        domain="[('create_date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter name="g_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="g_run" string="Run" context="{'group_by': 'run_id'}"/>
                    <filter name="g_config" string="Store" context="{'group_by': 'config_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bigcommerce_job" model="ir.actions.act_window">
        <field name="name">Queued Jobs</field>
        <field name="res_model">bigcommerce.job</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_f_pending': 1, 'search_default_f_failed': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No jobs queued</p>
            <p>
                Bulk pushes appear here when a store has
                <b>Run bulk operations in the background</b> switched on.
                They are executed by the scheduled action
                <b>BigCommerce: Run queued jobs</b>.
            </p>
        </field>
    </record>
</odoo>
