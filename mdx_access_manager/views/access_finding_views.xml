<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_access_finding_list" model="ir.ui.view">
        <field name="name">mdx.access.finding.list</field>
        <field name="model">mdx.access.finding</field>
        <field name="arch" type="xml">
            <list string="Findings" create="false"
                  decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'warning'"
                  decoration-muted="status != 'open'">
                <field name="severity"/>
                <field name="title"/>
                <field name="code" optional="show"/>
                <field name="group_id" optional="show"/>
                <field name="model_id" optional="show"/>
                <field name="status"/>
                <field name="detected_at" optional="hide"/>
                <button name="action_acknowledge" type="object" string="Acknowledge"
                        icon="fa-check" class="btn-link" invisible="status != 'open'"/>
                <button name="action_open_target" type="object" string="Open"
                        icon="fa-external-link" class="btn-link"/>
            </list>
        </field>
    </record>

    <record id="view_access_finding_form" model="ir.ui.view">
        <field name="name">mdx.access.finding.form</field>
        <field name="model">mdx.access.finding</field>
        <field name="arch" type="xml">
            <form string="Finding" create="false">
                <header>
                    <button name="action_acknowledge" type="object" string="Acknowledge"
                            invisible="status != 'open'"/>
                    <button name="action_reopen" type="object" string="Reopen"
                            invisible="status == 'open'"/>
                    <button name="action_open_target" type="object" string="Open Target"/>
                    <field name="status" widget="statusbar" statusbar_visible="open,acknowledged,resolved"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="title" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="code" readonly="1"/>
                            <field name="severity" readonly="1"/>
                            <field name="detected_at" readonly="1"/>
                        </group>
                        <group>
                            <field name="group_id" readonly="1"/>
                            <field name="model_id" readonly="1"/>
                            <field name="acl_id" readonly="1"/>
                            <field name="rule_id" readonly="1"/>
                        </group>
                    </group>
                    <separator string="What was found"/>
                    <field name="detail" readonly="1" nolabel="1"/>
                    <separator string="Recommendation"/>
                    <field name="recommendation" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_access_finding_search" model="ir.ui.view">
        <field name="name">mdx.access.finding.search</field>
        <field name="model">mdx.access.finding</field>
        <field name="arch" type="xml">
            <search string="Findings">
                <field name="title"/>
                <field name="code"/>
                <field name="group_id"/>
                <field name="model_id"/>
                <filter name="open" string="Open" domain="[('status','=','open')]"/>
                <separator/>
                <filter name="critical" string="Critical" domain="[('severity','=','critical')]"/>
                <filter name="warning" string="Warning" domain="[('severity','=','warning')]"/>
                <group>
                    <filter name="by_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="by_code" string="Check" context="{'group_by': 'code'}"/>
                    <filter name="by_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_access_finding" model="ir.actions.act_window">
        <field name="name">Findings</field>
        <field name="res_model">mdx.access.finding</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_open': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing found — run a scan</p>
            <p>Findings are decidable from the configuration alone: redundant implications, access
               controls that can never grant anything, global record rules that silently narrow
               group rules, and paths to Settings access nobody remembers creating.</p>
        </field>
    </record>

    <record id="action_access_finding_scan" model="ir.actions.server">
        <field name="name">Scan Access Configuration</field>
        <field name="model_id" ref="model_mdx_access_finding"/>
        <field name="state">code</field>
        <field name="code">model.action_scan()</field>
    </record>
</odoo>
