<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_access_manager" model="ir.module.category">
        <field name="name">Access Rights Manager</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_access_auditor" model="res.groups">
        <field name="name">Auditor</field>
        <field name="category_id" ref="mdx_access_manager.module_category_access_manager"/>
        <field name="comment">Read findings and the change log. Cannot resolve another user's rights or stage changes.</field>
    </record>

    <record id="group_access_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="mdx_access_manager.module_category_access_manager"/>
        <field name="implied_ids" eval="[(4, ref('mdx_access_manager.group_access_auditor'))]"/>
        <field name="comment">Resolve any user's effective rights, compare users, stage and apply group changes. Applying still requires the rights to write on Users.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('mdx_access_manager.group_access_manager'))]"/>
    </record>
</odoo>
