<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The report draws its own masthead, so the paperformat must not also
         reserve a band at the top of every page for Odoo's. -->
    <record id="paperformat_perf_health" model="report.paperformat">
        <field name="name">Performance Health Report</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">8</field>
        <field name="margin_bottom">10</field>
        <field name="margin_left">8</field>
        <field name="margin_right">8</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">96</field>
    </record>

    <record id="action_perf_health_report" model="ir.actions.report">
        <field name="name">Health Report</field>
        <field name="model">perf.audit.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mdx_perf_auditor.report_health</field>
        <field name="report_file">mdx_perf_auditor.report_health</field>
        <field name="print_report_name">'Odoo Health Report - %s' % ((object.date and object.date.strftime('%Y-%m-%d')) or object.id)</field>
        <field name="binding_model_id" ref="model_perf_audit_run"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_perf_health"/>
    </record>
</odoo>
