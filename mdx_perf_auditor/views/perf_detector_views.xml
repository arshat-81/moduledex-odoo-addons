<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="perf_detector_view_list" model="ir.ui.view">
        <field name="name">perf.detector.list</field>
        <field name="model">perf.detector</field>
        <field name="arch" type="xml">
            <!-- The catalogue is synced from code: a hand-made record would have no
                 detector behind it, so only editing is allowed. -->
            <list editable="bottom" default_order="code" create="false" delete="false">
                <field name="code" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="category" readonly="1"/>
                <field name="depth" readonly="1" widget="badge"/>
                <field name="default_severity" readonly="1" widget="badge"
                       decoration-danger="default_severity == 'critical'"
                       decoration-warning="default_severity == 'warning'"/>
                <field name="open_finding_count" string="Open" readonly="1"/>
                <field name="threshold_keys" readonly="1" optional="hide"/>
                <field name="active" widget="boolean_toggle"/>
                <button name="action_view_findings" type="object" string="Findings"
                        icon="fa-list" invisible="open_finding_count == 0"/>
            </list>
        </field>
    </record>

    <record id="perf_detector_view_search" model="ir.ui.view">
        <field name="name">perf.detector.search</field>
        <field name="model">perf.detector</field>
        <field name="arch" type="xml">
            <search>
                <field name="code"/>
                <field name="name"/>
                <filter name="enabled" string="Enabled" domain="[('active','=',True)]"/>
                <filter name="disabled" string="Disabled" domain="[('active','=',False)]"/>
                <filter name="deep" string="Deep only" domain="[('depth','=','deep')]"/>
                <filter name="firing" string="Currently firing" domain="[('open_finding_count','>',0)]"/>
                <group>
                    <filter name="g_cat" string="Category" context="{'group_by':'category'}"/>
                    <filter name="g_depth" string="Depth" context="{'group_by':'depth'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_perf_detector" model="ir.actions.act_window">
        <field name="name">Detectors</field>
        <field name="res_model">perf.detector</field>
        <field name="view_mode">list</field>
        <field name="context">{'search_default_g_cat': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Detector catalog is empty</p>
            <p>Upgrade the module to populate it.</p>
        </field>
    </record>
</odoo>
