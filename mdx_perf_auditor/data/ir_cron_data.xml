<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_run_audit" model="ir.cron">
            <field name="name">Performance Auditor: weekly audit</field>
            <field name="model_id" ref="model_perf_audit_run"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_audit()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="priority">50</field>
        </record>

        <record id="cron_db_snapshot" model="ir.cron">
            <field name="name">Performance Auditor: database statistics snapshot</field>
            <field name="model_id" ref="model_perf_db_snapshot"/>
            <field name="state">code</field>
            <field name="code">model.cron_snapshot()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="priority">60</field>
        </record>

        <record id="cron_capture_expire" model="ir.cron">
            <field name="name">Performance Auditor: close expired capture window</field>
            <field name="model_id" ref="model_perf_capture"/>
            <field name="state">code</field>
            <field name="code">model.cron_expire()</field>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="priority">70</field>
        </record>
    </data>
</odoo>
