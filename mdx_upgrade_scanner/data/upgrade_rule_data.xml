<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!--
    Every rule below was taken from the Odoo source, and source_ref says exactly
    where, so any of them can be checked rather than believed. Severity follows
    Odoo's own record: an API marked deprecated is removed one to two releases
    later, so "due" means marked two or more releases ago and still present -
    the set whose removal window is now.

    noupdate is deliberately off. A module update should bring new rules and
    corrected ones with it; a rule someone has switched off stays off, because
    active is not touched by an update once the record exists.
  -->

  <!-- ============================================================
       ALREADY REMOVED - these do not work on the version you run
       ============================================================ -->

  <record id="rule_get_resource_path" model="mdx.upgrade.rule">
    <field name="name">get_resource_path</field>
    <field name="title">get_resource_path() no longer exists</field>
    <field name="kind">call</field>
    <field name="pattern">get_resource_path</field>
    <field name="severity">removed</field>
    <field name="since_version">17.0</field>
    <field name="removed_in">19.0</field>
    <field name="replacement">odoo.tools.misc.file_path()</field>
    <field name="source_ref">present in 18.0 odoo/modules/module.py, absent in 19.0</field>
    <field name="explanation">Deprecated in 17.0 and deleted in 19.0. Code still calling it raises AttributeError at import time, so the module will not load at all.</field>
  </record>

  <record id="rule_flush_search" model="mdx.upgrade.rule">
    <field name="name">_flush_search</field>
    <field name="title">_flush_search() no longer exists</field>
    <field name="kind">call</field>
    <field name="pattern">_flush_search</field>
    <field name="severity">removed</field>
    <field name="since_version">18.0</field>
    <field name="removed_in">19.0</field>
    <field name="replacement">Flushing is handled by the ORM; drop the call</field>
    <field name="source_ref">present in 18.0 odoo/models.py, absent in 19.0</field>
    <field name="explanation">Deprecated in 18.0 and gone one release later - the shortest gap Odoo has taken, and a good illustration of why "deprecated" is not "safe for another few years".</field>
  </record>

  <record id="rule_name_get" model="mdx.upgrade.rule">
    <field name="name">name_get</field>
    <field name="title">name_get() was replaced by display_name</field>
    <field name="kind">call</field>
    <field name="pattern">name_get</field>
    <field name="severity">removed</field>
    <field name="since_version">17.0</field>
    <field name="removed_in">17.0</field>
    <field name="replacement">_compute_display_name(), or read display_name</field>
    <field name="source_ref">absent from Model in 18.0 and 19.0</field>
    <field name="explanation">A method defined on your own model is simply never called any more, which is worse than an error: record names quietly fall back to the default and nobody notices for months.</field>
  </record>

  <record id="rule_fields_view_get" model="mdx.upgrade.rule">
    <field name="name">fields_view_get</field>
    <field name="title">fields_view_get() was replaced by get_view()</field>
    <field name="kind">call</field>
    <field name="pattern">fields_view_get</field>
    <field name="severity">removed</field>
    <field name="since_version">16.0</field>
    <field name="removed_in">17.0</field>
    <field name="replacement">get_view() / _get_view()</field>
    <field name="source_ref">absent from Model in 18.0 and 19.0</field>
    <field name="explanation">An override of this name is dead code: the ORM no longer calls it, so whatever view surgery it performed silently stops happening.</field>
  </record>

  <record id="rule_osv_osv" model="mdx.upgrade.rule">
    <field name="name">odoo.osv.osv</field>
    <field name="title">odoo.osv.osv has been deleted</field>
    <field name="kind">import</field>
    <field name="pattern">odoo.osv.osv</field>
    <field name="severity">removed</field>
    <field name="since_version">17.0</field>
    <field name="removed_in">19.0</field>
    <field name="replacement">odoo.models / odoo.exceptions</field>
    <field name="source_ref">absent in 19.0</field>
    <field name="explanation">The compatibility shim for pre-8.0 imports is finally gone. An import of it fails immediately.</field>
  </record>

  <record id="rule_tools_ignore" model="mdx.upgrade.rule">
    <field name="name">odoo.tools.ignore</field>
    <field name="title">tools.ignore() has been deleted</field>
    <field name="kind">call</field>
    <field name="pattern">ignore</field>
    <field name="severity">removed</field>
    <field name="since_version">16.0</field>
    <field name="removed_in">18.0</field>
    <field name="replacement">contextlib.suppress()</field>
    <field name="source_ref">present in 17.0, absent in 18.0</field>
    <field name="explanation">Deprecated in 16.0, removed in 18.0. Note this rule matches any call named ignore, so switch it off if your code has one of its own.</field>
    <field name="active" eval="False"/>
  </record>

  <record id="rule_xml_tree" model="mdx.upgrade.rule">
    <field name="name">&lt;tree&gt;</field>
    <field name="title">&lt;tree&gt; views are now &lt;list&gt;</field>
    <field name="kind">xml_tag</field>
    <field name="pattern">tree</field>
    <field name="severity">removed</field>
    <field name="since_version">17.0</field>
    <field name="removed_in">19.0</field>
    <field name="replacement">&lt;list&gt;</field>
    <field name="source_ref">odoo/addons/base/models/ir_ui_view.py:149 - the type selection offers list, not tree</field>
    <field name="explanation">The view type no longer exists, so the view fails to load and takes the module install with it.</field>
    <field name="applies_to_py" eval="False"/>
    <field name="applies_to_xml" eval="True"/>
  </record>

  <record id="rule_xml_attrs" model="mdx.upgrade.rule">
    <field name="name">attrs=</field>
    <field name="title">attrs is no longer used</field>
    <field name="kind">xml_attr</field>
    <field name="pattern">attrs</field>
    <field name="severity">removed</field>
    <field name="since_version">17.0</field>
    <field name="removed_in">17.0</field>
    <field name="replacement">invisible="", readonly="", required="" with a plain expression</field>
    <field name="source_ref">odoo/addons/base/models/ir_ui_view.py:493 - raises ValidationError</field>
    <field name="explanation">Odoo raises a validation error naming the view, so this one stops the install outright rather than misbehaving quietly.</field>
    <field name="applies_to_py" eval="False"/>
    <field name="applies_to_xml" eval="True"/>
  </record>

  <record id="rule_xml_states" model="mdx.upgrade.rule">
    <field name="name">states=</field>
    <field name="title">states is no longer used</field>
    <field name="kind">xml_attr</field>
    <field name="pattern">states</field>
    <field name="severity">removed</field>
    <field name="since_version">17.0</field>
    <field name="removed_in">17.0</field>
    <field name="replacement">invisible="state not in ['a','b']"</field>
    <field name="source_ref">odoo/addons/base/models/ir_ui_view.py:493 - raises ValidationError</field>
    <field name="explanation">Rejected by the same check as attrs.</field>
    <field name="applies_to_py" eval="False"/>
    <field name="applies_to_xml" eval="True"/>
  </record>

  <!-- groups_id is split three ways rather than pattern-matched once. A raw
       search for the word also hits every sentence that mentions it, which is
       how a migration tool's own documentation ends up in your report. -->
  <record id="rule_groups_id_attr" model="mdx.upgrade.rule">
    <field name="name">.groups_id</field>
    <field name="title">res.users.groups_id is now group_ids</field>
    <field name="kind">attr</field>
    <field name="pattern">groups_id</field>
    <field name="severity">removed</field>
    <field name="since_version">19.0</field>
    <field name="removed_in">19.0</field>
    <field name="replacement">group_ids</field>
    <field name="source_ref">odoo/addons/base/models/res_users.py:257</field>
    <field name="explanation">Renamed on res.users in 19.0 with no alias left behind, so reading it raises immediately.</field>
  </record>

  <record id="rule_groups_id_str" model="mdx.upgrade.rule">
    <field name="name">"groups_id"</field>
    <field name="title">groups_id used as a field name</field>
    <field name="kind">strkey</field>
    <field name="pattern">groups_id</field>
    <field name="severity">removed</field>
    <field name="since_version">19.0</field>
    <field name="removed_in">19.0</field>
    <field name="replacement">"group_ids"</field>
    <field name="source_ref">odoo/addons/base/models/res_users.py:257</field>
    <field name="explanation">In a create() dictionary, a write(), or a list of field names. Matches the exact string only, so a sentence mentioning groups_id is not a finding.</field>
  </record>

  <record id="rule_groups_id_xml" model="mdx.upgrade.rule">
    <field name="name">&lt;field name="groups_id"&gt;</field>
    <field name="title">groups_id in a data file or view</field>
    <field name="kind">xml_field</field>
    <field name="pattern">groups_id</field>
    <field name="severity">removed</field>
    <field name="since_version">19.0</field>
    <field name="removed_in">19.0</field>
    <field name="replacement">&lt;field name="group_ids"&gt;</field>
    <field name="source_ref">odoo/addons/base/models/res_users.py:257</field>
    <field name="explanation">A data file assigning groups to a user stops loading, which fails the whole module install.</field>
    <field name="applies_to_py" eval="False"/>
    <field name="applies_to_xml" eval="True"/>
  </record>

