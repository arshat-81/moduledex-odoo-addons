<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="module_category_upgrade" model="ir.module.category">
    <field name="name">Upgrade Scanner</field>
    <field name="sequence">56</field>
  </record>

  <record id="privilege_upgrade" model="res.groups.privilege">
    <field name="name">Upgrade Scanner</field>
    <field name="sequence">56</field>
    <field name="category_id" ref="mdx_upgrade_scanner.module_category_upgrade"/>
  </record>

  <record id="group_upgrade_user" model="res.groups">
    <field name="name">Reviewer</field>
    <field name="privilege_id" ref="mdx_upgrade_scanner.privilege_upgrade"/>
    <field name="comment">Run scans and read the findings.</field>
  </record>

  <record id="group_upgrade_manager" model="res.groups">
    <field name="name">Administrator</field>
    <field name="privilege_id" ref="mdx_upgrade_scanner.privilege_upgrade"/>
    <field name="implied_ids" eval="[(4, ref('mdx_upgrade_scanner.group_upgrade_user'))]"/>
    <field name="comment">Also add and edit the rules the scanner uses.</field>
  </record>

  <record id="base.group_system" model="res.groups">
    <field name="implied_ids" eval="[(4, ref('mdx_upgrade_scanner.group_upgrade_manager'))]"/>
  </record>
</odoo>
