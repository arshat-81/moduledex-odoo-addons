<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_access_denial_list" model="ir.ui.view">
        <field name="name">mdx.access.denial.list</field>
        <field name="model">mdx.access.denial</field>
        <field name="arch" type="xml">
            <list string="Blocked Attempts" create="false" edit="false">
                <field name="last_seen"/>
                <field name="user_id"/>
                <field name="operation"/>
                <field name="model"/>
                <field name="profile_name" string="Profile"/>
                <field name="count"/>
                <field name="res_ids" optional="hide"/>
                <field name="first_seen" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_access_denial_search" model="ir.ui.view">
        <field name="name">mdx.access.denial.search</field>
        <field name="model">mdx.access.denial</field>
        <field name="arch" type="xml">
            <search string="Blocked Attempts">
                <field name="user_id"/>
                <field name="model"/>
                <field name="profile_name"/>
                <filter name="today" string="Today"
                        domain="[('last_seen', '&gt;=', 'today')]"/>
                <filter name="api" string="API Logins" domain="[('operation', '=', 'block_api')]"/>
                <group>
                    <filter name="by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="by_profile" string="Profile" context="{'group_by': 'profile_name'}"/>
                    <filter name="by_model" string="Model" context="{'group_by': 'model'}"/>
                    <filter name="by_operation" string="Operation" context="{'group_by': 'operation'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_access_denial" model="ir.actions.act_window">
        <field name="name">Blocked Attempts</field>
        <field name="res_model">mdx.access.denial</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing has been blocked yet</p>
            <p>Every time an enforced profile stops a user - a refused edit, a blocked export,
               an API login - it is recorded here with the profile responsible.</p>
        </field>
    </record>
</odoo>
