<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_access_preview_form" model="ir.ui.view">
        <field name="name">mdx.access.preview.form</field>
        <field name="model">mdx.access.preview</field>
        <field name="arch" type="xml">
            <form string="Preview">
                <group>
                    <field name="profile_id" readonly="1"/>
                    <field name="user_id" options="{'no_create': True}"/>
                    <field name="applies" invisible="1"/>
                </group>
                <field name="report_html" nolabel="1" readonly="1"/>
                <footer>
                    <button string="Close" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
