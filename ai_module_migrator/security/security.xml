<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ai_module_migrator" model="ir.module.category">
        <field name="name">Odoo Module Upgrade AI</field>
        <field name="sequence">45</field>
    </record>

    <record id="privilege_ai_module_migrator_access" model="res.groups.privilege">
        <field name="name">Odoo Module Upgrade AI</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="ai_module_migrator.module_category_ai_module_migrator"/>
    </record>

    <record id="group_ai_module_migrator_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="ai_module_migrator.privilege_ai_module_migrator_access"/>
    </record>

    <record id="group_ai_module_migrator_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="ai_module_migrator.privilege_ai_module_migrator_access"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_module_migrator_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <!-- The multi-company record rules live in ir.access.csv: Odoo 20 merged
         ir.rule into ir.access, where a row without a group is a restriction
         that applies to everyone. -->
</odoo>
