<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_ai_module_migrator" model="ir.module.category">
        <field name="name">Odoo Module Upgrade AI</field>
        <field name="sequence">45</field>
    </record>

    <record id="privilege_ai_module_migrator_access" model="res.groups.privilege">
        <field name="name">Odoo Module Upgrade AI</field>
        <field name="sequence">45</field>
        <field name="category_id" ref="ai_module_migrator.module_category_ai_module_migrator"/>
    </record>

    <record id="group_ai_module_migrator_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="ai_module_migrator.privilege_ai_module_migrator_access"/>
    </record>

    <record id="group_ai_module_migrator_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="ai_module_migrator.privilege_ai_module_migrator_access"/>
        <field name="implied_ids" eval="[(4, ref('group_ai_module_migrator_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="ai_module_migration_job_company_rule" model="ir.rule">
            <field name="name">AI migration jobs multi-company</field>
            <field name="model_id" ref="model_ai_module_migration_job"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

        <record id="ai_module_migration_file_company_rule" model="ir.rule">
            <field name="name">AI migration files multi-company</field>
            <field name="model_id" ref="model_ai_module_migration_file"/>
            <field name="domain_force">['|', ('job_id.company_id', '=', False), ('job_id.company_id', 'in', company_ids)]</field>
        </record>

        <record id="ai_module_migration_log_company_rule" model="ir.rule">
            <field name="name">AI migration logs multi-company</field>
            <field name="model_id" ref="model_ai_module_migration_log"/>
            <field name="domain_force">['|', ('job_id.company_id', '=', False), ('job_id.company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
