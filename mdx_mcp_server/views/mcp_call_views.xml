<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mcp_call_list" model="ir.ui.view">
        <field name="name">mdx.mcp.call.list</field>
        <field name="model">mdx.mcp.call</field>
        <field name="arch" type="xml">
            <list string="Calls" create="false" decoration-danger="status == 'denied'"
                  decoration-warning="status in ('error', 'pending')"
                  decoration-bf="is_write">
                <field name="create_date" string="When"/>
                <field name="tool_name" string="Tool"/>
                <field name="user_id" string="As"/>
                <field name="client_name" string="Client" optional="hide"/>
                <field name="model_name" string="Model"/>
                <field name="status"/>
                <field name="records_touched" string="Rows"/>
                <field name="result_summary" string="Result"/>
                <field name="duration_ms" string="ms" optional="hide"/>
                <field name="is_write" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_call_form" model="ir.ui.view">
        <field name="name">mdx.mcp.call.form</field>
        <field name="model">mdx.mcp.call</field>
        <field name="arch" type="xml">
            <form string="Call" create="false" edit="false">
                <sheet>
                    <div class="oe_title"><h1><field name="tool_name" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="user_id" readonly="1"/>
                            <field name="client_name" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                            <field name="approval_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="status" readonly="1"/>
                            <field name="records_touched" readonly="1"/>
                            <field name="duration_ms" string="Duration (ms)" readonly="1"/>
                            <field name="create_date" readonly="1"/>
                        </group>
                    </group>
                    <separator string="Result"/>
                    <field name="result_summary" readonly="1" nolabel="1"/>
                    <separator string="Arguments the model sent"/>
                    <field name="arguments" readonly="1" nolabel="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mcp_call_search" model="ir.ui.view">
        <field name="name">mdx.mcp.call.search</field>
        <field name="model">mdx.mcp.call</field>
        <field name="arch" type="xml">
            <search string="Calls">
                <field name="tool_name"/>
                <field name="user_id"/>
                <field name="model_name"/>
                <filter name="writes" string="Writes Only" domain="[('is_write','=',True)]"/>
                <filter name="problems" string="Denied or Failed"
                        domain="[('status','in',['denied','error'])]"/>
                <separator/>
                <filter name="today" string="Today"
                        domain="[('create_date','&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00'))]"/>
                <group>
                    <filter name="by_tool" string="Tool" context="{'group_by': 'tool_name'}"/>
                    <filter name="by_user" string="User" context="{'group_by': 'user_id'}"/>
                    <filter name="by_status" string="Status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_mcp_call" model="ir.actions.act_window">
        <field name="name">Call Log</field>
        <field name="res_model">mdx.mcp.call</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
