<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_mcp_approval_list" model="ir.ui.view">
        <field name="name">mdx.mcp.approval.list</field>
        <field name="model">mdx.mcp.approval</field>
        <field name="arch" type="xml">
            <list string="Approvals" create="false"
                  decoration-warning="state == 'pending'"
                  decoration-muted="state in ('rejected','expired')">
                <field name="create_date" string="Requested"/>
                <field name="summary"/>
                <field name="requested_by_id"/>
                <field name="model_name"/>
                <field name="state"/>
                <field name="decided_by_id" optional="show"/>
                <button name="action_approve" type="object" string="Approve"
                        icon="fa-check" class="btn-link" invisible="state != 'pending'"/>
                <button name="action_reject" type="object" string="Reject"
                        icon="fa-times" class="btn-link" invisible="state != 'pending'"/>
            </list>
        </field>
    </record>

    <record id="view_mcp_approval_form" model="ir.ui.view">
        <field name="name">mdx.mcp.approval.form</field>
        <field name="model">mdx.mcp.approval</field>
        <field name="arch" type="xml">
            <form string="Approval" create="false">
                <header>
                    <button name="action_approve" type="object" string="Approve and Run"
                            class="btn-primary" invisible="state != 'pending'"
                            confirm="This runs the change as the user the agent authenticated as. Continue?"/>
                    <button name="action_reject" type="object" string="Reject"
                            invisible="state != 'pending'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="pending,approved,rejected"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="summary" readonly="1"/></h1></div>
                    <group>
                        <group>
                            <field name="tool_id" readonly="1"/>
                            <field name="requested_by_id" readonly="1"/>
                            <field name="client_name" readonly="1"/>
                            <field name="model_name" readonly="1"/>
                        </group>
                        <group>
                            <field name="create_date" readonly="1"/>
                            <field name="decided_by_id" readonly="1"/>
                            <field name="decided_at" readonly="1"/>
                            <field name="decision_note"/>
                        </group>
                    </group>
                    <separator string="What it would do (dry run, nothing written)"/>
                    <field name="preview" readonly="1" nolabel="1"/>
                    <separator string="Arguments the model sent"/>
                    <field name="arguments" readonly="1" nolabel="1"/>
                    <separator string="Result" invisible="not result_summary"/>
                    <field name="result_summary" readonly="1" nolabel="1"
                           invisible="not result_summary"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mcp_approval" model="ir.actions.act_window">
        <field name="name">Approvals</field>
        <field name="res_model">mdx.mcp.approval</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing waiting</p>
            <p>When an agent asks for a change that needs a human, it appears here with a
               dry-run preview of exactly what it would do.</p>
        </field>
    </record>
</odoo>
