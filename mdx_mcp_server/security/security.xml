<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_mcp" model="ir.module.category">
        <field name="name">MCP Server</field>
        <field name="sequence">38</field>
    </record>

    <record id="privilege_mcp" model="res.groups.privilege">
        <field name="name">MCP Server</field>
        <field name="sequence">38</field>
        <field name="category_id" ref="mdx_mcp_server.module_category_mcp"/>
    </record>

    <record id="group_mcp_reviewer" model="res.groups">
        <field name="name">Reviewer</field>
        <field name="privilege_id" ref="mdx_mcp_server.privilege_mcp"/>
        <field name="comment">Read the call log and approve or reject queued writes.</field>
    </record>

    <record id="group_mcp_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="privilege_id" ref="mdx_mcp_server.privilege_mcp"/>
        <field name="implied_ids" eval="[(4, ref('mdx_mcp_server.group_mcp_reviewer'))]"/>
        <field name="comment">Configure which tools exist, what they may touch and whether they need approval.</field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('mdx_mcp_server.group_mcp_manager'))]"/>
    </record>
</odoo>
